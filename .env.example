# Environment Configuration

# App
NODE_ENV=development
APP_NAME="Marketplace Super App"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/marketplace?schema=public"
MONGODB_URI="mongodb://localhost:27017/marketplace"
REDIS_URL="redis://localhost:6379"

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# Payments
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM="Marketplace <noreply@marketplace.com>"

# SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Cloud Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=marketplace-assets
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Maps
GOOGLE_MAPS_API_KEY=your-google-maps-key
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Search
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_API_KEY=your-algolia-admin-key
ALGOLIA_SEARCH_KEY=your-algolia-search-key

# AI & ML
OPENAI_API_KEY=your-openai-api-key
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-west1-gcp

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# Monitoring
SENTRY_DSN=your-sentry-dsn
LOGROCKET_APP_ID=your-logrocket-id

# Shipping
FEDEX_API_KEY=your-fedex-key
UPS_API_KEY=your-ups-key
DHL_API_KEY=your-dhl-key

# Web3
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-infura-key
WALLET_CONNECT_PROJECT_ID=your-walletconnect-id

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Socket.io
SOCKET_PORT=4001
SOCKET_CORS_ORIGIN=http://localhost:3000

# Redis Bull Queue
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_DB=1

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Security
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=your-cookie-secret
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Features Flags
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_AR_PREVIEW=true
ENABLE_LIVE_SHOPPING=true
ENABLE_CRYPTO_PAYMENTS=true
