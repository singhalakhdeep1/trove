{
    "name": "marketplace-super-app",
    "version": "1.0.0",
    "private": true,
    "description": "A comprehensive multi-vendor marketplace platform",
    "scripts": {
        "setup": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../mobile && npm install",
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:frontend": "cd frontend && npm run dev",
        "dev:backend": "cd backend && npm run start:dev",
        "dev:mobile": "cd mobile && npm start",
        "build": "npm run build:frontend && npm run build:backend",
        "build:frontend": "cd frontend && npm run build",
        "build:backend": "cd backend && npm run build",
        "test": "npm run test:frontend && npm run test:backend",
        "test:frontend": "cd frontend && npm run test",
        "test:backend": "cd backend && npm run test",
        "docker:dev": "docker-compose -f docker/docker-compose.dev.yml up",
        "docker:prod": "docker-compose -f docker/docker-compose.prod.yml up -d",
        "migrate": "cd backend && npx prisma migrate dev",
        "seed": "cd backend && npx prisma db seed",
        "studio": "cd backend && npx prisma studio"
    },
    "workspaces": [
        "frontend",
        "backend",
        "mobile",
        "shared"
    ],
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    }
}